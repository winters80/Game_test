#!/bin/sh
# System Breaker — run test suites before push
# Installed by scripts/install-hooks.sh / scripts/install-hooks.ps1
cd "$(git rev-parse --show-toplevel)"

# Runs every test file in the repo. The two main suites
# (test_characters / test_quests) gate the core gameplay surface; the
# supplementary tests under tests/ and test_runs.py cover migrations,
# the background worker, and the guild simulator. All five must pass
# before a push is allowed.

run_suite() {
    label="$1"
    cmd="$2"
    echo ""
    echo "  Running $label..."
    echo ""
    eval "$cmd"
    rc=$?
    if [ $rc -ne 0 ]; then
        echo ""
        echo "  $label FAILED. Push aborted."
        echo "  Fix the issues above, then push again."
        echo ""
        exit 1
    fi
}

run_suite "test_characters.py"        "python -X utf8 test_characters.py"
run_suite "test_quests.py"            "python -X utf8 test_quests.py"
run_suite "test_runs.py"              "python -X utf8 test_runs.py"
run_suite "tests/test_db_migrations"  "python -X utf8 tests/test_db_migrations.py"
run_suite "tests/test_background_tick" "python -X utf8 tests/test_background_tick.py"
run_suite "tests/test_guild_betrayal" "python -X utf8 tests/test_guild_betrayal.py"
run_suite "tests/test_guild_founding" "python -X utf8 tests/test_guild_founding.py"

echo ""
echo "  ✓ All 7 test suites passed. Pushing."
echo ""
exit 0
