#!/bin/sh
# System Breaker — run test suites before push
# Installed by scripts/install-hooks.sh / scripts/install-hooks.ps1
cd "$(git rev-parse --show-toplevel)"

# Runs every test file in the repo. The two main suites
# (test_characters / test_quests) gate the core gameplay surface; the
# supplementary tests under tests/ and test_runs.py cover migrations,
# the background worker, and the guild simulator. All five must pass
# before a push is allowed.

# Pick a Python that can import the project's dependencies. A bare
# `python` is often the wrong interpreter on machines with several
# installs (e.g. a newer Python without pydantic first on PATH), which
# made every push fail with ModuleNotFoundError. Override with PYTHON=...
find_python() {
    if [ -n "$PYTHON" ]; then
        echo "$PYTHON"
        return 0
    fi
    for candidate in python python3 "py -3.13" "py -3.12" "py -3.11" "py -3.10" py; do
        if $candidate -c "import pydantic, rich, questionary" >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

PY="$(find_python)"
if [ -z "$PY" ]; then
    echo ""
    echo "  No Python with the project's dependencies was found."
    echo "  Run: python -m pip install -r requirements.txt"
    echo "  or set PYTHON to the right interpreter. Push aborted."
    echo ""
    exit 1
fi
echo "  Using Python: $PY ($($PY -c 'import sys; print(sys.version.split()[0])'))"

run_suite() {
    label="$1"
    cmd="$2"
    echo ""
    echo "  Running $label..."
    echo ""
    eval "$cmd"
    rc=$?
    if [ $rc -ne 0 ]; then
        echo ""
        echo "  $label FAILED. Push aborted."
        echo "  Fix the issues above, then push again."
        echo ""
        exit 1
    fi
}

run_suite "test_characters.py"        "$PY -X utf8 test_characters.py"
run_suite "test_quests.py"            "$PY -X utf8 test_quests.py"
run_suite "test_runs.py"              "$PY -X utf8 test_runs.py"
run_suite "tests/test_db_migrations"  "$PY -X utf8 tests/test_db_migrations.py"
run_suite "tests/test_background_tick" "$PY -X utf8 tests/test_background_tick.py"
run_suite "tests/test_guild_betrayal" "$PY -X utf8 tests/test_guild_betrayal.py"
run_suite "tests/test_guild_founding" "$PY -X utf8 tests/test_guild_founding.py"

echo ""
echo "  ✓ All 7 test suites passed. Pushing."
echo ""
exit 0
